# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional: switch provider with LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_FAST_MODEL=gpt-4o-mini
LLM_SMART_MODEL=gpt-4o
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_SMART_MODEL=claude-opus-5-5
# OFFLINE=1 forces deterministic fallbacks even when a key is present
OFFLINE=0
